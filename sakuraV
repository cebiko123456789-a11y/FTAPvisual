Lighting.FogColor = Color3.fromRGB(140, 90, 200)
Lighting.FogStart = 80
Lighting.FogEnd = 600

-- Очистка старой графики
for _, v in ipairs(Lighting:GetChildren()) do
    if v:IsA("Atmosphere") or v:IsA("BloomEffect") or v:IsA("ColorCorrectionEffect") or v:IsA("SunRaysEffect") then
        v:Destroy()

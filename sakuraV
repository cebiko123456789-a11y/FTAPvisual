atmosphere.Color = Color3.fromRGB(160, 120, 220)
atmosphere.Decay = Color3.fromRGB(100, 70, 170)
atmosphere.Density = 0.2
atmosphere.Glare = 0.1
atmosphere.Haze = 0.8

local bloom = Instance.new("BloomEffect", Lighting)

bloom.Size = 20
bloom.Threshold = 1.5

local colorCorrection = Instance.new("ColorCorrectionEffect", Lighting)
colorCorrection.Brightness = 0
colorCorrection.Contrast = 0.15
colorCorrection.Saturation = 0.2
colorCorrection.TintColor = Color3.fromRGB(220, 190, 255)

local sunRays = Instance.new("SunRaysEffect", Lighting)
sunRays.Intensity = 0.03
sunRays.Spread = 0.2

-- Сохранение дефолтов для тумана
local defaultColor = Lighting.FogColor
local defaultStart = Lighting.FogStart
local defaultEnd = Lighting.FogEnd
local defaultBrightness = Lighting.Brightness
local defaultAmbient = Lighting.OutdoorAmbient
local defaultAtmosphereColor = atmosphere.Color
local defaultAtmosphereDecay = atmosphere.Decay
local defaultAtmosphereDensity = atmosphere.Density

-- ============================================================
-- КНОПКИ УПРАВЛЕНИЯ (F, N, P, V)
-- ============================================================
UIS.InputBegan:Connect(function(input, gpe)
    if gpe then return end

    -- [F] — Переключение вида (3-е лицо) + Тоггл Трейла
    if input.KeyCode == Enum.KeyCode.F then
        isThirdPerson = not isThirdPerson

        if isThirdPerson then
            player.CameraMode = Enum.CameraMode.Classic
            player.CameraMinZoomDistance = 15
            player.CameraMaxZoomDistance = 15
            if currentFireTrail then currentFireTrail.Enabled = true end
        else
            player.CameraMode = Enum.CameraMode.LockFirstPerson
            player.CameraMinZoomDistance = 0.5
            player.CameraMaxZoomDistance = 0.5
            if currentFireTrail then currentFireTrail.Enabled = false end
        end

    -- [N] — Тоггл Подсветки игроков
    elseif input.KeyCode == Enum.KeyCode.N then
        highlightsEnabled = not highlightsEnabled
        for _, plr in pairs(Players:GetPlayers()) do
            if plr.Character then
                local h = plr.Character:FindFirstChild("PinkHighlight")
                if h then h.Enabled = highlightsEnabled end
            end
        end

    -- [P] — Смена циклов времени суток
    elseif input.KeyCode == Enum.KeyCode.P then
        currentMode = currentMode + 1
        if currentMode > #modes then currentMode = 1 end
        Lighting.ClockTime = modes[currentMode].Time
        Lighting.Brightness = modes[currentMode].Brightness

    -- [V] — Тоггл Темного Фиолетового Тумана
    elseif input.KeyCode == Enum.KeyCode.V then
        fogEnabled = not fogEnabled
        if fogEnabled then
            Lighting.FogColor = Color3.fromRGB(45, 15, 70)
            Lighting.FogStart = 15
            Lighting.FogEnd = 180
            Lighting.Brightness = 0.5
            Lighting.OutdoorAmbient = Color3.fromRGB(40, 25, 55)
            atmosphere.Color = Color3.fromRGB(40, 10, 65)
            atmosphere.Decay = Color3.fromRGB(55, 20, 85)
            atmosphere.Density = 0.25
        else
            Lighting.FogColor = defaultColor
            Lighting.FogStart = defaultStart
            Lighting.FogEnd = defaultEnd
            Lighting.Brightness = defaultBrightness
            Lighting.OutdoorAmbient = defaultAmbient
            atmosphere.Color = defaultAtmosphereColor
            atmosphere.Decay = defaultAtmosphereDecay
            atmosphere.Density = defaultAtmosphereDensity
        end
    end
end)

-- ============================================================
-- ВСПОМОГАТЕЛЬНЫЕ ФУНКЦИИ (Джамп Кирл, Подсветка)
-- ============================================================
local Colors = {Color3.fromRGB(255,120,180), Color3.fromRGB(210,90,255), Color3.fromRGB(140,80,255), Color3.fromRGB(255,120,180)}
local function LerpColor(a,b,t)
    return Color3.new(a.R + (b.R - a.R) * t, a.G + (b.G - a.G) * t, a.B + (b.B - a.B) * t)
end

local function GetColor(t)
    local seg = math.floor(t * 3) + 1
    local localT = (t * 3) % 1
    return LerpColor(Colors[seg], Colors[math.min(seg + 1,#Colors)], localT)
end

local function CreateStars(pos)
    local holder = Instance.new("Part", workspace)
    holder.Anchored, holder.CanCollide, holder.Transparency, holder.Position = true, false, 1, pos

    local emitter = Instance.new("ParticleEmitter", holder)
    emitter.Texture = "rbxassetid://296874871"
    emitter.Rate = 0
    emitter.Lifetime = NumberRange.new(1.5, 2.5)
    emitter.Speed = NumberRange.new(1, 2)
    emitter.Rotation = NumberRange.new(0, 360)
    emitter.RotSpeed = NumberRange.new(-40, 40)
    emitter.LightEmission = 0.8
    emitter.Color = ColorSequence.new{
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,120,180)),
        ColorSequenceKeypoint.new(0.5, Color3.fromRGB(210,90,255)),
        ColorSequenceKeypoint.new(1, Color3.fromRGB(140,80,255))
    }
    emitter.Size = NumberSequence.new{NumberSequenceKeypoint.new(0,0.35), NumberSequenceKeypoint.new(1,0)}
    emitter.Transparency = NumberSequence.new{NumberSequenceKeypoint.new(0,0.45), NumberSequenceKeypoint.new(1,1)}
    emitter.SpreadAngle = Vector2.new(360, 360)
    emitter:Emit(20)

    task.delay(3, function() holder:Destroy() end)
end

-- Джамп Кирл (Jump Ring) при падении
local function CreateRing(pos)
    local segments, radius = 64, 4
    for i = 1, segments do
        local t = i / segments
        local angle = math.rad((360 / segments) * i)
        local part = Instance.new("Part", workspace)
        part.Anchored, part.CanCollide, part.Material, part.Transparency = true, false, Enum.Material.Neon, 0.2
        part.Color = GetColor(t)
        part.Size = Vector3.new(0.15, 0.15, 1)

        local offset = Vector3.new(math.cos(angle) * radius, 0.05, math.sin(angle) * radius)
        part.Position = pos + offset
        part.CFrame = CFrame.lookAt(part.Position, pos)

        TweenService:Create(part, TweenInfo.new(2.5), {Position = pos, Size = Vector3.new(0.01,0.01,0.01), Transparency = 1}):Play()
        task.delay(2.5, function() part:Destroy() end)
    end
    CreateStars(pos)
end

-- Подсветка игроков
local function AddHighlight(plr)
    if plr.Character and not plr.Character:FindFirstChild("PinkHighlight") then
        local h = Instance.new("Highlight")
        h.Name = "PinkHighlight"
        h.FillColor = Color3.fromRGB(180, 60, 120)
        h.OutlineColor = Color3.fromRGB(220, 100, 160)
        h.FillTransparency = 0.75
        h.OutlineTransparency = 0.4
        h.DepthMode = Enum.HighlightDepthMode.Occluded
        h.Enabled = highlightsEnabled
        h.Parent = plr.Character
    end
end

local function setupHighlightForPlayer(plr)
    if plr.Character then AddHighlight(plr) end
    plr.CharacterAdded:Connect(function()
        task.wait(1)
        AddHighlight(plr)
    end)
end

Players.PlayerAdded:Connect(setupHighlightForPlayer)
for _, plr in pairs(Players:GetPlayers()) do setupHighlightForPlayer(plr) end

-- ============================================================
-- ОСНОВНАЯ СБОРКА ПЕРСОНАЖА (Шляпа, Хвосты, Трейл, Кольца)
-- ============================================================
local HAT_SIZE = Vector3.new(2.4, 0.8, 2.4) 
local HEIGHT_OFFSET = 0.75                  
local HAT_TRANSPARENCY = 0.55               
local COLOR_NEON_PURPLE = Color3.fromRGB(110, 0, 210) 
local COLOR_DARK_PURPLE = Color3.fromRGB(35, 0, 75)   

local function setupCharacter(char)
    task.wait(0.5)
    if not char then return end

    local hum = char:WaitForChild("Humanoid", 5)
    local rootPart = char:WaitForChild("HumanoidRootPart", 5) or char:WaitForChild("Torso", 5) or char:WaitForChild("UpperTorso", 5)
    if not hum or not rootPart then return end

    -- 1. Джамп Кирл (кольца)
    hum.StateChanged:Connect(function(_, state)
        if state == Enum.HumanoidStateType.Freefall then
            CreateRing(rootPart.Position - Vector3.new(0, 3, 0))
        end
    end)

    -- Очистка старых аттачментов и эмиттеров, если они были
    if rootPart:FindFirstChild("TrailBottom") then rootPart.TrailBottom:Destroy() end
    if rootPart:FindFirstChild("TrailTop") then rootPart.TrailTop:Destroy() end
    if rootPart:FindFirstChild("FireTrailEmitter") then rootPart.FireTrailEmitter:Destroy() end

    -- Точки крепления (полный размер)
    local attBottom = Instance.new("Attachment", rootPart)
    attBottom.Name = "TrailBottom"
    attBottom.Position = Vector3.new(0, -2.5, 0)

    local attTop = Instance.new("Attachment", rootPart)
    attTop.Name = "TrailTop"
    attTop.Position = Vector3.new(0, 1.5, 0)

    -- 2. ВОЗВРАЩЕН ТВОЙ РОДНОЙ ТРЕЙЛ-ОГОНЕК
    currentFireTrail = Instance.new("Trail", rootPart)
    currentFireTrail.Name = "OriginalFireTrail"
    currentFireTrail.Attachment0 = attBottom
    currentFireTrail.Attachment1 = attTop
    
    -- Твои точные настройки:
    currentFireTrail.Texture = "rbxassetid://89925832"
    currentFireTrail.TextureMode = Enum.TextureMode.Stretch
    
    -- ФОРМА: Широкий у тела (1.0), сужается в точку в конце (0.0)
    currentFireTrail.WidthScale = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1.0), 
        NumberSequenceKeypoint.new(1, 0.0)  
    })
    
    -- ЦВЕТ: От яркого фиолетового к темно-фиолетовому
    currentFireTrail.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(120, 0, 255)),  
        ColorSequenceKeypoint.new(0.4, Color3.fromRGB(40, 0, 120)), 
        ColorSequenceKeypoint.new(1, Color3.fromRGB(5, 0, 15))      
    })
    
    -- ПРОЗРАЧНОСТЬ: Плотный в начале, полностью исчезает в конце
    currentFireTrail.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.0), 
        NumberSequenceKeypoint.new(1, 1.0)  
    })
    
    currentFireTrail.LightEmission = 0.8
    currentFireTrail.Lifetime = 1.5
    
    -- Синхронизация видимости с текущим видом камеры (F)
    currentFireTrail.Enabled = isThirdPerson

    -- 3. Создание Шляпы с хвостами
    local head = char:WaitForChild("Head", 5)
    if head then
        local hatPart = Instance.new("Part", char)
        hatPart.Name, hatPart.Size, hatPart.Material, hatPart.Transparency = "LocalChinaHat", HAT_SIZE, Enum.Material.SmoothPlastic, HAT_TRANSPARENCY
        hatPart.CanCollide, hatPart.CanTouch, hatPart.CanQuery, hatPart.Massless = false, false, false, true
        
        local weld = Instance.new("Weld", hatPart)
        weld.Part0, weld.Part1, weld.C0 = head, hatPart, CFrame.new(0, HEIGHT_OFFSET, 0)

        local mesh = Instance.new("SpecialMesh", hatPart)
        mesh.MeshType, mesh.MeshId, mesh.Scale = Enum.MeshType.FileMesh, "rbxassetid://1033714", Vector3.new(HAT_SIZE.X, HAT_SIZE.Y * 2, HAT_SIZE.Z)

        local texture = Instance.new("Texture", hatPart)
        texture.Texture, texture.Face = "rbxassetid://14421111242", Enum.NormalId.Top

        local highlight = Instance.new("Highlight", hatPart)
        highlight.FillTransparency, highlight.OutlineTransparency, highlight.OutlineColor, highlight.Adornee = 0.3, 0.5, COLOR_NEON_PURPLE, hatPart

        local tableTween = TweenInfo.new(2.5, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true)
        TweenService:Create(hatPart, tableTween, {Color = COLOR_NEON_PURPLE}):Play()
        TweenService:Create(highlight, tableTween, {FillColor = COLOR_DARK_PURPLE}):Play()
        hatPart.Color, highlight.FillColor = COLOR_DARK_PURPLE, COLOR_NEON_PURPLE

        local tailSegments = {}
        local offsets = {Vector3.new(0.6, 0.2, 0), Vector3.new(-0.6, 0.2, 0), Vector3.new(0, 0.2, 0.6), Vector3.new(0, 0.2, -0.6)}
        local currentRotation = 0
        local connection
        
        connection = RunService.RenderStepped:Connect(function(deltaTime)
            if not char:IsDescendantOf(workspace) or not hatPart:IsDescendantOf(workspace) then
                connection:Disconnect()
                for _, seg in ipairs(tailSegments) do seg:Destroy() end
                return
            end
            
            -- Скрытие от первого лица
            if (Camera.Focus.Position - Camera.CFrame.Position).Magnitude < 2 then
                hatPart.Transparency = 1 
                highlight.Enabled = false 
                for _, seg in ipairs(tailSegments) do seg:Destroy() end
                table.clear(tailSegments)
            else
                hatPart.Transparency = HAT_TRANSPARENCY 
                highlight.Enabled = true 
                currentRotation = (currentRotation + (340 * deltaTime)) % 360
                weld.C0 = CFrame.new(0, HEIGHT_OFFSET, 0) * CFrame.Angles(0, math.rad(currentRotation), 0)

                -- Спавн хвостов шляпы
                for _, offset in ipairs(offsets) do
                    local segment = Instance.new("Part", char)
                    segment.Size, segment.Material, segment.Anchored = Vector3.new(0.6, 0.6, 0.6), Enum.Material.Neon, true
                    segment.CanCollide, segment.CanTouch, segment.CanQuery, segment.CastShadow = false, false, false, false
                    
                    local pMesh = Instance.new("SpecialMesh", segment)
                    pMesh.MeshType = Enum.MeshType.Sphere
                    segment.Position = hatPart.Position + hatPart.CFrame:VectorToWorldSpace(offset)
                    table.insert(tailSegments, 1, segment)
                end
                
                -- Очистка хвостов
                for i = #tailSegments, 1, -1 do
                    local seg = tailSegments[i]
                    if seg and seg:IsDescendantOf(workspace) then
                        local progress = i / #tailSegments 
                        local sizeMult = (1 - progress) * 1.2
                        seg.Size = Vector3.new(0.6 * sizeMult, 0.6 * sizeMult, 0.6 * sizeMult)
                        seg.Transparency = 0.1 + (0.9 * progress)
                        seg.Color = COLOR_NEON_PURPLE:Lerp(COLOR_DARK_PURPLE, progress)
                        
                        if i > 35 * #offsets then
                            seg:Destroy()
                            table.remove(tailSegments, i)
                        end
                    else
                        table.remove(tailSegments, i)
                    end
                end
            end
        end)
    end
end

-- Инициализация персонажа
if player.Character then task.spawn(setupCharacter, player.Character) end
player.CharacterAdded:Connect(setupCharacter)

-- Старт с первого лица
player.CameraMode = Enum.CameraMode.LockFirstPerson

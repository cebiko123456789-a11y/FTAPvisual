local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local UIS = game:GetService("UserInputService")

local player = Players.LocalPlayer
local Camera = workspace.CurrentCamera

-- Состояния кнопок
local isThirdPerson = false
local highlightsEnabled = true
local fogEnabled = false
local currentFireTrail = nil -- Твой оригинальный Trail

-- Настройки времени для кнопки [P]
local modes = {
    {Time = 6.5, Brightness = 2.5},
    {Time = 12, Brightness = 2},
    {Time = 18.5, Brightness = 1.8},
    {Time = 22, Brightness = 1}
}
local currentMode = 1

-- Настройки неба и тумана
Lighting.ClockTime = 18.3
Lighting.Brightness = 2
Lighting.ExposureCompensation = -0.2
